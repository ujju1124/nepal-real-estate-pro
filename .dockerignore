# ═══════════════════════════════════════════════════════════════
# Docker Ignore — Excludes unnecessary files from Docker context
# ═══════════════════════════════════════════════════════════════

# Git
.git
.gitignore
.gitattributes

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed at runtime)
*.md
!README.md

# Jupyter notebooks (not needed at runtime)
notebooks/
*.ipynb
.ipynb_checkpoints/

# Archive data (raw/intermediate data not needed at runtime)
archive/

# Utilities (old files not needed at runtime)
utilities/

# Docker files
Dockerfile
docker-compose.yml

# Secrets (use HF Spaces secrets instead)
.env
!.env.example
.streamlit/secrets.toml

# Testing
test_*.py
*_test.py
tests/
